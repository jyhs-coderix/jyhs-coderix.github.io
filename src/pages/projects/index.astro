---
import ProjectCard from "@/components/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSortedProjects } from "@/lib/content";

const projects = await getSortedProjects();
---

<BaseLayout title="프로젝트" description="coderix 프로젝트 목록">
  <section class="page-head container">
    <h1>프로젝트</h1>
    <p>coderix가 만들고 기록한 프로젝트를 모았습니다.</p>
  </section>
  <section class="section">
    <div class="container">
      {projects.length ? <div class="grid">{projects.map((project) => <ProjectCard project={project} />)}</div> : <p class="empty">아직 등록된 프로젝트가 없습니다.</p>}
    </div>
  </section>
</BaseLayout>

