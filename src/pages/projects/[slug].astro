---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, getProjectAuthors, getSortedProjects } from "@/lib/content";

export async function getStaticPaths() {
  const projects = await getSortedProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const authors = getProjectAuthors(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article class="article">
    <header class="article-header">
      <div class="meta">
        <span>{formatDate(project.data.date)}</span>
        <span>프로젝트</span>
        {authors.length > 0 && <span>{authors.join(", ")}</span>}
      </div>
      <h1>{project.data.title}</h1>
      <p>{project.data.description}</p>
      {
        project.data.links.length > 0 && (
          <div class="tag-list">
            {project.data.links.map((link) => (
              <a class="tag" href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
            ))}
          </div>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
