---
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPostsByCategory } from "@/lib/content";

const posts = await getPostsByCategory("notice");
---

<BaseLayout title="공지" description="coderix 공지">
  <section class="page-head container">
    <h1>공지</h1>
    <p>운영진이 남기는 공식 안내입니다.</p>
  </section>
  <section class="section">
    <div class="container">
      {posts.length ? <div class="list">{posts.map((post) => <PostCard post={post} />)}</div> : <p class="empty">아직 공지가 없습니다.</p>}
    </div>
  </section>
</BaseLayout>

