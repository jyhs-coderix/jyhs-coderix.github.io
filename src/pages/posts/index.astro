---
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSortedPosts } from "@/lib/content";

const posts = await getSortedPosts();
---

<BaseLayout title="전체 글" description="coderix의 전체 글 목록">
  <section class="page-head container">
    <h1>전체 글</h1>
    <p>활동 기록, 개발 글, 공지를 최신순으로 모았습니다.</p>
  </section>
  <section class="section">
    <div class="container">
      {posts.length ? <div class="list">{posts.map((post) => <PostCard post={post} />)}</div> : <p class="empty">아직 등록된 글이 없습니다.</p>}
    </div>
  </section>
</BaseLayout>

