---
import PostCard from "@/components/PostCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPostsByCategory } from "@/lib/content";

const posts = await getPostsByCategory("activity");
---

<BaseLayout title="활동 기록" description="coderix 월간 활동 기록">
  <section class="page-head container">
    <h1>활동 기록</h1>
    <p>정기 모임, 스터디, 행사, 회고를 월별로 남깁니다.</p>
  </section>
  <section class="section">
    <div class="container">
      {posts.length ? <div class="list">{posts.map((post) => <PostCard post={post} />)}</div> : <p class="empty">아직 활동 기록이 없습니다.</p>}
    </div>
  </section>
</BaseLayout>

